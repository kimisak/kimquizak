# Copy this template to .env for local development. Never commit real keys.
# Enable Maps JavaScript API and restrict each key to its own websites.
# Restart the dev server after changing environment variables.

# Local development: restrict to http://localhost:3000/* (or your actual port).
GOOGLE_MAPS_API_DEV_KEY=

# Vercel: set this in Project Settings > Environment Variables > Production.
# Restrict to https://kimquizak.com/* and https://www.kimquizak.com/*.
# Keep the actual production key in Vercel; leave this blank locally.
# Redeploy production after changing its environment variables.
GOOGLE_MAPS_API_PROD_KEY=

# Optional deployment-specific override, compatible with the original setup.
# If non-empty, this wins over DEV_KEY and PROD_KEY in every environment.
# Existing Vercel deployments using this name do not need to rename it.
GOOGLE_MAPS_API_KEY=

# These are browser Maps keys: the app sends the selected key to the browser.
# Do not prefix these names with NEXT_PUBLIC_. Apply website/API restrictions.
# Use a separate restricted key for previews if Street View is needed there.

# Supabase project > Connect: copy the Project URL and publishable key.
# Add the same names in Vercel's Production environment before building.
# NEXT_PUBLIC_ values are embedded into browser code at build time; redeploy
# after changing them. Do not put a secret/service_role key in either field.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Authentication > Users: UUID of the only permitted app host.
# Server-only. Must match the host enrolled by the Supabase SQL setup.
KIMQUIZAK_OWNER_USER_ID=
